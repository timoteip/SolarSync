# Copy to .env.local and fill in. Never commit real values.

# Supabase project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# Service role key. Server-side only — this bypasses row level security,
# so it must never be exposed to the browser or prefixed with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
